# ForgeFlow environment example. No real secrets belong in this file.
#
# Copy to .env and fill in. .env is gitignored.

# Required for live discovery (Phase 1). A read-only token is enough; ForgeFlow
# never writes to GitHub. Fine-grained tokens need "Public Repositories (read)".
GITHUB_TOKEN=

# Required for 'forgeflow analyze' (Phase 2). Get one from Google AI Studio.
# Without it, analyze fails closed and makes no request.
GEMINI_API_KEY=

# Optional. Required for 'implement --provider jules'. Jules API keys can only
# be created in the Jules web app (jules.google.com/settings); there is no API
# to mint one. Without it, the Jules provider fails closed.
JULES_API_KEY=

# Emergency stop. Set to 1 (or any truthy value) to halt all model calls and
# sandbox execution immediately. 'kill_switch: true' in
# config/repositories.yaml does the same thing.
FORGEFLOW_KILL_SWITCH=
